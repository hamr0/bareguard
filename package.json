{
  "name": "bareguard",
  "version": "0.17.0",
  "description": "Action-side runtime policy library for autonomous agents — bounds what the agent does, not what it says. Sibling of bareagent in the bare suite.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./types": {
      "types": "./types/types.d.ts",
      "default": "./src/types.js"
    },
    "./primitives.json": "./primitives.json"
  },
  "files": [
    "src",
    "types",
    "primitives.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "bareguard.context.md",
    "bareguard.rwx.json"
  ],
  "primitives": "./primitives.json",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "build:types": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build:primitives && npm run build:types",
    "build:primitives": "node scripts/gen-primitives.mjs",
    "check:primitives": "node scripts/gen-primitives.mjs --check",
    "check:lockfile": "node scripts/check-lockfile.mjs"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "litectx": "^0.13.0",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0",
  "author": "hamr0",
  "homepage": "https://github.com/hamr0/bareguard#readme",
  "bugs": {
    "url": "https://github.com/hamr0/bareguard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamr0/bareguard.git"
  },
  "keywords": [
    "agent",
    "policy",
    "guard",
    "runtime",
    "audit",
    "budget",
    "llm",
    "ai",
    "bareagent",
    "baresuite"
  ]
}
